     mpp_assert(hw_regs);
 
+    {
+        const char *dump_dir = getenv("VP9_REG_PRE_DUMP");
+
+        if (dump_dir) {
+            static RK_U32 frame_index;
+            char path[256];
+            FILE *fp;
+            RK_U32 *words;
+            RK_U32 i;
+
+            snprintf(path, sizeof(path), "%s/reg_%02u.txt",
+                     dump_dir, frame_index);
+            fp = fopen(path, "wb");
+            if (fp) {
+                words = (RK_U32 *)&hw_regs->comm_gen;
+                for (i = 0; i < sizeof(hw_regs->comm_gen) / 4; i++)
+                    fprintf(fp, "%03u: %08x\n", i + 8, words[i]);
+                words = (RK_U32 *)&hw_regs->comm_paras;
+                for (i = 0; i < sizeof(hw_regs->comm_paras) / 4; i++)
+                    fprintf(fp, "%03u: %08x\n", i + 64, words[i]);
+                words = (RK_U32 *)&hw_regs->comm_addr;
+                for (i = 0; i < sizeof(hw_regs->comm_addr) / 4; i++)
+                    fprintf(fp, "%03u: %08x\n", i + 128, words[i]);
+                words = (RK_U32 *)&hw_regs->statistic;
+                for (i = 0; i < sizeof(hw_regs->statistic) / 4; i++)
+                    fprintf(fp, "%03u: %08x\n", i + 256, words[i]);
+                fclose(fp);
+            }
+
+            snprintf(path, sizeof(path), "%s/probe_%02u.bin",
+                     dump_dir, frame_index);
+            fp = fopen(path, "wb");
+            if (fp) {
+                fwrite(mpp_buffer_get_ptr(hw_ctx->probe_base), 1,
+                       PROB_SIZE, fp);
+                fclose(fp);
+            }
+
+            snprintf(path, sizeof(path), "%s/default_%02u.bin",
+                     dump_dir, frame_index);
+            fp = fopen(path, "wb");
+            if (fp) {
+                fwrite(mpp_buffer_get_ptr(hw_ctx->prob_default_base), 1,
+                       PROB_SIZE, fp);
+                fclose(fp);
+            }
+            frame_index++;
+        }
+    }
+
 
